      "layer": "content",
      "layoutMode": "grid",
      "gridRows": 3,
      "gridCols": 3,
      "gapToken": 0,
      "allowedKinds": [
        "text",
        "chart",
        "table",
        "image"
      ],
      "minItems": 0,
      "maxItems": 9,
      "styleSlots": {
        "text": "text.body",
        "padding": 3
      }
    }
  ],
  "variants": {
    "compact": {
      "placeholders": [
        {
          "id": "header",
          "paddingToken": 1
        },
        {
          "id": "metrics",
          "paddingToken": 0,
          "gapToken": 0
