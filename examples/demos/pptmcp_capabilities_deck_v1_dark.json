      "fills": {
        "title": {
          "content": "Why PPTMCP"
        },
        "left": {
          "items": [
            {
              "kind": "text",
              "text": "Pain points",
              "textStyleSlot": "text.subtitle"
            },
            {
              "kind": "list",
              "style": "number",
              "bullet": {
                "size": "md",
                "gap": 6,
                "color": "text"
              },
              "indent": {
                "left": 0,
                "hanging": 18
              },
              "lineGap": 6,
              "items": [
                {
                  "text": "Manual slide production is slow, error-prone, and hard to scale across teams."
                },
                {
                  "text": "Layout drift appears across themes, fonts, and PowerPoint versions."
                },
                {
                  "text": "Lack of strict validation makes regressions invisible until late review."
                },
                {
                  "text": "Automation pipelines lack deterministic rendering guarantees."
                }
              ]
            }
          ]
        },
        "right": {
          "items": [
            {
              "kind": "card",
              "variant": "surface",
              "header": {
                "title": "Deterministic"
              },
              "body": [
                {
                  "type": "list",
                  "style": "dot",
                  "items": [
                    {
                      "text": "Same spec, same PPTX output."
                    },
                    {
                      "text": "Geometry v1 invariants prevent drift."
                    }
                  ]
                }
              ]
            },
            {
              "kind": "card",
              "variant": "elevated",
              "header": {
                "title": "Template-first"
              },
              "body": [
                {
                  "type": "list",
                  "style": "dot",
                  "items": [
                    {
                      "text": "Template v1 compiles to regions."
                    },
                    {
                      "text": "No absolute positioning in specs."
                    }
                  ]
                }
              ]
            },
            {
              "kind": "card",
              "variant": "surface",
              "header": {
